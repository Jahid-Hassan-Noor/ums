DOCKERHUB_NAMESPACE=your-dockerhub-username
IMAGE_TAG=latest

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nginx,backend,frontend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost
NEXT_PUBLIC_API_URL=/api
BACKEND_API_URL=http://backend:8000

# SMTP email. Keep the real password only in the untracked .env file or your
# production secret manager. Gmail requires an App Password, not your login password.
